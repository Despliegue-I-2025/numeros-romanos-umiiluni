{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/a2r.js": {
      "maxDuration": 10
    },
    "api/r2a.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/a2r",
      "dest": "/api/a2r.js"
    },
    {
      "src": "/r2a",
      "dest": "/api/r2a.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}