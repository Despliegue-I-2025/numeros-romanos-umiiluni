{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {},
  "functions": {
    "api/a2r.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/r2a.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/a2r",
      "methods": ["GET"],
      "dest": "/api/a2r.js"
    },
    {
      "src": "/r2a", 
      "methods": ["GET"],
      "dest": "/api/r2a.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ]
}